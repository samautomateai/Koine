      "key": "retry.provider.maxRetryDelayMs",
      "type": "number",
      "status": "todo"
    },
    {
      "key": "shellPath",
      "type": "string",
      "status": "todo"
    },
    {
      "key": "shellCommandPrefix",
      "type": "string",
      "status": "todo"
    },
    {
      "key": "npmCommand",
      "type": "string[]",
      "status": "todo",
      "note": "Needs package support (REQ-PKG-001)."
    },
    {
      "key": "selfUpdateCommand",
      "type": "string[]",
      "status": "by-design",
      "scope": "global",
      "note": "A Go binary is updated through its package manager."
    },
    {
      "key": "packages",
      "type": "array",
      "status": "todo",
      "note": "REQ-PKG-001."
    },
    {
      "key": "extensions",
      "type": "array",
      "status": "verified",
      "test": "TestSettingsExtensionsMixedStringsAndObjects",
      "note": "Strings are extension paths (like `plugin`); objects are Koine extension specs (any language)."
    },
    {
      "key": "skills",
      "type": "string[]",
      "status": "todo",
      "note": "Skills are found by directory convention today."
    },
    {
      "key": "prompts",
      "type": "string[]",
      "status": "todo"
    },
    {
      "key": "themes",
      "type": "string[]",
      "status": "inert"
    },
    {
      "key": "enableSkillCommands",
      "type": "boolean",
      "status": "todo"
    },
    {
      "key": "collapseChangelog",
      "type": "boolean",
      "status": "by-design",
      "note": "Koine shows no changelog after updates."
    },
    {
      "key": "enableInstallTelemetry",
      "type": "boolean",
      "status": "by-design",
      "note": "Koine has no telemetry."
    },
    {
      "key": "enableAnalytics",
      "type": "boolean",
      "status": "by-design",
      "note": "Koine has no analytics."
    },
    {
      "key": "warnings.anthropicExtraUsage",
      "type": "boolean",
      "status": "todo"
    }
  ],
  "koine": [
    {
      "key": "model",
      "type": "string",
      "note": "Alias of defaultProvider/defaultModel (the earlier Koine name); `--model` and KOINE_MODEL override it."
    },
    {
      "key": "maxTurns",
      "type": "number",
      "note": "Tool-loop turns per prompt (default 50)."
    },
    {
      "key": "hooks",
      "type": "object",
      "note": "Claude-compatible command hooks (REQ-HOOK-001)."
    },
    {
      "key": "plugin",
      "type": "string[]",
      "note": "opencode-style plugin paths or npm names."
    },
    {
      "key": "providers",
      "type": "object",
      "note": "Extra OpenAI-compatible or Anthropic-type endpoints; project entries need trust."
    },
    {
      "key": "compaction.contextWindow",
      "type": "number",
      "note": "Context window in tokens until Koine has a model catalog (default 200000)."
    },
    {
      "key": "$schema",
      "type": "string",
      "note": "Accepted for editor validation."
    }
  ]
}
