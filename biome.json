{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/bin",
      "!tui-bubbletea",
      "!desktop",
      "!core/app/testdata",
      "!compat/test/fixture",
      "!compat/pi.json",
      "!core/ext/sidecar/surface.json",
      "!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noEmptyBlockStatements": "off", "noVar": "error" },
      "style": { "useConst": "error", "useTemplate": "off" }
    }
  }
}
